# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Obrigatória: chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opcionais (os valores abaixo são os padrões)
# OPENAI_MODEL=gpt-6-luna
# MAX_HISTORY_TURNS=10
# REQUEST_TIMEOUT=60

# Opcional: rastreamento no LangSmith (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=python-chatbot
